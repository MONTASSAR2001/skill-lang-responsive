  "license": "MIT",
  "author": "MONTASSAR2001 (https://github.com/MONTASSAR2001)",
  "homepage": "https://github.com/MONTASSAR2001/skill-lang-responsive#readme",
  "repository": { "type": "git", "url": "git+https://github.com/MONTASSAR2001/skill-lang-responsive.git" },
  "bugs": { "url": "https://github.com/MONTASSAR2001/skill-lang-responsive/issues" },
  "keywords": ["agent-skills", "claude-code", "claude-code-plugin", "cursor", "codex", "antigravity", "copilot", "responsive-design", "localization", "i18n", "rtl", "playwright"],
  "type": "module",
  "private": false,
  "bin": { "skill-lang-responsive": "scripts/install.mjs" },
